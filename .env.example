# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard > Project Settings > API). The anon key is safe in the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to demo to run on sample data in the browser instead of Supabase.
# VITE_DATA=demo

# While payments use Flutterwave's sandbox, screens show a short "Test mode" note.
# When Nestly takes real money, set this to live (here and in Vercel) and the notes go away.
# VITE_PAYMENTS=live
